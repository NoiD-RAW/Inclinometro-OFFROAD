{
  "name": "inclinometrorn",
  "version": "2.2.0",
  "main": "index.ts",
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.25",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:config && npm run test:ui",
    "store:privacy": "node --experimental-strip-types store/generate-privacy.mjs",
    "test:config": "node --test plugins/*.test.js",
    "test:ui": "node --test src/themes/industrial/*.test.cjs",
    "store:check": "python3 store/comprobar_ficha.py && node --experimental-strip-types store/generate-privacy.mjs --check"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
